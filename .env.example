# Discord bot token (required)
DISCORD_TOKEN=

# Optional: Discord application ID (auto-detected from token if omitted)
DISCORD_CLIENT_ID=

# Lavalink node configuration (required for audio playback)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_ID=main

# UI style for the "Now Playing" controls: "menu", "button", or "none"
STYLE_CONTROLS=menu

# Message rendering mode: "components_v2" (Discord Components V2) or "cards" (musicard + EmbedBuilder)
MESSAGE_STYLE=components_v2

# Default search source for Lavalink (e.g. ytsearch, ytmsearch, spsearch, scsearch)
DEFAULT_SEARCH_SOURCE=ytsearch
